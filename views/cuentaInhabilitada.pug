extends layout.pug 

block content
    body(class="bg-gray-200/70")
        div(class="flex justify-center items-center h-150")
            div(class="grid-grid-cols-1")
                div(class="border-2 border-red-400 rounded-[10px] w-175 p-8")
                    h1(class="text-3xl text-red-700 text-center font-bold") Tu cuenta ha sido inhabilitada
                    h1(class="text-lg mb-6")
                    |   Acumulaste 3 publicaciones dadas de baja por incumplir las normas de la plataforma, 
                    |   por lo que ya no podés usar esta cuenta.
        
                div(class="mt-10 flex justify-center items-center")
                    form(action="/cerrarSesion", method="post") 
                        button(type="submit" class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded-md cursor-pointer") Cerrar Sesión
