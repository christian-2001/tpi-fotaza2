extends ../layout.pug 
include ../mixins/home/homeMixin

block content
    +home()

    .div_contentValidador(class="mt-20 grid grid-cols-1 justify-center items-center")
        h1(class="text-center text-3xl") Publicaciones pendientes de revisión

        .revisarPosts(class=(posts.length === 1 ? "grid grid-cols-1 mx-170 mt-10 gap-4" : "grid grid-cols-3 mx-60 mt-10 gap-4"))
            each post in posts
                .post(class="relative bg-white border-1 border-gray-400 rounded-[10px] p-2 hover:outline-3 hover:outline-orange-400 hover:opacity-80 h-fit")
                    a.urlPostRevision(href=`/validador/publicacion/${post.id_post}` class="absolute inset-0")

                    .post_usuario(class="text-center text-[20px]")
                        h1(class="font-bold text-red-700") Denuncias acumuladas: #{post.cantDenuncias}
                        p
                            | Publicado por 
                            a(href=`/usuarioPerfil/${post.Usuario.id_usuario}/posts` class="relative z-10 hover:font-bold") #{post.Usuario.nombre_usuario}
                            |  - #{post.fh_publicacion.toLocaleDateString()} - #{post.fh_publicacion.toLocaleTimeString()}

                    .post_titulo(class="mt-3 text-center text-3xl font-bold")
                        h1 #{post.titulo}

                    .post_descripcion(class="mt-5 text-1xl")
                        p #{post.descripcion}

                    .post_etiquetas(class="mt-2")
                        p Etiquetas:
                        .etiquetas
                            each etiqueta in post.Etiqueta
                                span(class="font-bold text-blue-600 mr-[3px]") ##{etiqueta.nom_etiqueta}

                    .post_imagenes(class="bg-gray-400 border-[1px] border-gray-400/50")
                        .imagenes(class=(post.Imagens.length > 1 ? "grid grid-cols-2 gap-[1px]" : "grid grid-cols-1"))
                            each post_img in post.Imagens
                                .img_elem
                                    img(src=post_img.img_path)