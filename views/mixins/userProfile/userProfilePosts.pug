mixin renderPosts(sección, postsSección, esFavorito, guardada)
    if postsSección.length > 0               
        div(class=(postsSección.length === 1) ? "flex justify-center mt-6 mx-60" : "flex justify-center mt-6")
            .user_posts(class=(postsSección.length === 1) ? "grid grid-cols-1 mx-20 gap-4" : "grid grid-cols-2 mx-20 gap-4")
                each post in postsSección
                    .post(class="relative bg-white border-1 border-gray-400 rounded-[10px] p-2 hover:outline-3 hover:outline-orange-400 hover:opacity-80 h-fit")
                        if post.id_usuario !== userSession.id
                            .post_opciones(class="absolute z-1 right-2 top-[-20px]") 
                                button(type="button" class="boton_opciones text-5xl hover:text-gray-300 cursor-pointer") ...

                        ul(class="opciones hidden absolute bg-gray-200 top-7 right-2 mt-2 z-10", id=`post${post.id_post}`)
                            - esFavorito = false
                            each postFav in postsFavorito
                                if (post.id_post === postFav.id_post)
                                        
                                    if (esFavorito === false)          
                                        li(id="quitar-de-favoritos")
                                            form(action=`/quitar-de-favoritos/${post.id_post}`, method="post", name="quitarFavoritos_noduenio", id="quitarFavoritos_noduenio") 
                                                label(for="btn_quitarFavoritos") 
                                                    button(class="w-45 text-center py-[3px] border-b-1 border-black hover:bg-orange-400 cursor-pointer", id="btn_quitarFavoritos_coleccion") Eliminar de Favoritos
                                                    - esFavorito = true
                                        li(id="guardar-en-colección")
                                            label(for="btn_colección")
                                                button(type="button" class="w-45 text-center py-[3px] border-b-1 border-black hover:bg-orange-400 cursor-pointer" id="btn_colección") Guardar en Colección
                                    else
                                        li(id="agregar-a-favoritos")
                                            form(action=`/favoritos/${post.id_post}`, method="post", name="guardarFavoritos", id="guardarFavoritos") 
                                                label(for="btn_favoritos") 
                                                    button(class="w-45 text-center py-[3px] border-b-1 border-black hover:bg-orange-400 cursor-pointer", id="btn_favoritos") Guardar en Favoritos

                                        li(id="guardar-en-coleccion")
                                            label(for="btn_colección")
                                                button(type="button" class="w-45 text-center py-[3px] border-b-1 border-black hover:bg-orange-400 cursor-pointer" id="btn_colección") Guardar en Colección                
                                           
                            if esFavorito === false
                                li(id="agregar-a-favoritos")
                                    form(action=`/favoritos/${post.id_post}`, method="post", name="guardarFavoritos", id="guardarFavoritos") 
                                        label(for="btn_favoritos") 
                                            button(class="w-45 text-center py-[3px] border-b-1 border-black hover:bg-orange-400 cursor-pointer", id="btn_favoritos") Guardar en Favoritos
                                li(id="guardar-en-coleccion")
                                    label(for="btn_colección")
                                        button(type="button" class="w-45 text-center py-[3px] border-b-1 border-black hover:bg-orange-400 cursor-pointer" id="btn_colección") Guardar en Colección                

                        ul(class="opciones2 hidden absolute bg-gray-200 top-7 right-2 mt-2 z-10", id=`post${post.id_post}`)
                            li(class="border-black border-b-2")
                                div(class="flex justify-center items-center py-1")
                                    label(for="crearColeccion_opciones2")
                                        button(class="w-45 text-center text-blue-700 hover:font-bold cursor-pointer " id="crearColeccion_opciones2") + Crear colección

                            each c in userAuthColecciones
                                - guardada = false                                                   
                                li(class="coleccion border-b-1 border-black")
                                    div(class="flex justify-between items-center p-2")
                                        p(class="mr-10")= c.nombre_colección

                                        if postsUserAuthColecciones.length > 0
                                            - const _guardada = postsUserAuthColecciones.some(pc => pc.id_colección === c.id_colección && pc.id_post === post.id_post);
                                            - guardada = _guardada
                                            if guardada
                                                form(action="/quitar-de-coleccion", method="post" class="ml-10" name= c.nombre_colección id= c.nombre_colección)
                                                    label(for="btn_colección_guardado")
                                                        button(class="cursor-pointer px-2 py-1" type="submit" id="btn_colección_guardado")
                                                            svg(xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24") 
                                                                path(d="M18.5,2h-13C5.224,2,5,2.224,5,2.5v19c0,0.171,0.087,0.329,0.23,0.421c0.143,0.093,0.324,0.104,0.479,0.033L12,19.051	l6.291,2.903C18.357,21.984,18.429,22,18.5,22c0.094,0,0.188-0.026,0.27-0.079C18.913,21.829,19,21.671,19,21.5v-19	C19,2.224,18.776,2,18.5,2z")
                                            else                            
                                                form(action="/guardar-en-coleccion", method="post" class="ml-10" name= c.nombre_colección id= c.nombre_colección)
                                                    label(for="btn_colección")
                                                        button(class="cursor-pointer px-2 py-1" type="submit" id="btn_colección" disabled=(c.nombre_colección === userColeccion))                                                          
                                                            svg(xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24") 
                                                                path(d="M 5.5 2 A 0.50005 0.50005 0 0 0 5 2.5 L 5 21.5 A 0.50005 0.50005 0 0 0 5.7089844 21.953125 L 12 19.050781 L 18.291016 21.953125 A 0.50005 0.50005 0 0 0 19 21.5 L 19 2.5 A 0.50005 0.50005 0 0 0 18.5 2 L 5.5 2 z M 6 3 L 18 3 L 18 20.71875 L 12.208984 18.046875 A 0.50005 0.50005 0 0 0 11.791016 18.046875 L 6 20.71875 L 6 3 z")

                        .post_usuario(class="text-center text-[20px]")
                            p
                                |   Publicado por  
                                a(href=`/usuarioPerfil/${post.Usuario.id_usuario}/posts` class="hover:font-bold") #{post.Usuario.nombre_usuario}
                                |   - #{post.fh_publicacion.toLocaleDateString()} - #{post.fh_publicacion.toLocaleTimeString()}
                        .post_titulo(class="mt-3 text-center text-3xl font-bold hover:text-black/50")
                            a.url_post(href=`/post/${post.id_post}/${post.Imagens.length - post.Imagens.length}` class="cursor-pointer hover:text-3xl")
                                h1 #{post.titulo}
                        .post_descripcion(class="mt-5 text-1xl")
                            p #{post.descripcion}
                        .post_etiquetas(class="mt-2")
                            p Etiquetas:
                                form(action="/buscar" method="get")
                                    each postTags in post.Etiqueta
                                        label(for=`${postTags.nom_etiqueta}`)
                                            button(type="submit" name="etiqueta" id="etiqueta" value=`${postTags.nom_etiqueta}` class="cursor-pointer hover:text-blue-500/50 font-bold text-blue-600 mr-[3px]") ##{postTags.nom_etiqueta}
                        .post_imagenes(class="bg-gray-400 border-[1px] border-gray-400/50")
                            if post.Imagens.length > 1
                                .imagenes(class="grid grid-cols-2 gap-[1px]")
                                    each post_img in post.Imagens
                                        img(src=`${post_img.img_path}`)
                            else if post.Imagens.length == 1
                                .imagenes(class="grid grid-cols-1")
                                    each post_img in post.Imagens
                                        img(src=`${post_img.img_path}`)
    else
        if sección === "posts"
            p(class="text-center text-[2rem] my-5 font-medium") No hay publicaciones

        else if sección === "favoritos"
            p(class="text-center text-[2rem] my-5 font-medium") No hay publicaciones, explora publicaciones y guárdalos en tu perfil

        else if sección === "postsFollowing"
            p(class="text-center text-[2rem] my-5 font-medium") No hay publicaciones, sigue a otros usuarios para ver sus publicaciones aqui

        else if sección === "colecciones"
            p(class="text-center text-[2rem] my-5 font-medium") No hay publicaciones dentro de la coleccion 
