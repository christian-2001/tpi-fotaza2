mixin home(query = undefined)
        body(class= (userSession && userSession.rol === "validador") ? "bg-cyan-100/70 relative" : "bg-gray-200/70 relative")
            .bar_naranja(class="bg-orange-400 px-10 text-2xl h-15 flex justify-between items-center")
                if userSession
                    a(href= (userSession.rol === "validador") ? "/validador" : "/" class="hover:font-bold") Home 
                else
                    a(href="/" class="hover:font-bold") Home 

                unless ocultarBuscador
                    form(action="/buscar", method="get" id="form_buscar") 
                        .buscador(class="ml-56 items-center")
                            if query
                                input(class="bg-white text-[20px] p-2 mr-10 w-xl rounded-md focus:outline-orange-300" type="text" name="buscador" id="buscador" value=`${query}`) 
                            else
                                input(class="bg-white text-[20px] p-2 mr-10 w-xl rounded-md focus:outline-orange-300" type="text" name="buscador" id="buscador") 
                            button#btn_buscador(type="submit" class="bg-white py-2 px-8 text-[20px] rounded-md hover:bg-amber-400") Buscar
                .user(class="flex gap-10 items-center")
                    if userSession
                        a(href=`/usuarioPerfil/posts` class="py-2 hover:font-bold") 
                            p= userSession.user_name
                        form(action="/cerrarSesion", method="post") 
                            button(type="submit" class="bg-white px-6 py-1 hover:bg-red-500 hover:text-white cursor-pointer") Cerrar Sesión
                    else
                        a(href="/registrarse/crearPerfil" class="py-2 hover:font-bold") 
                            p Registrarse
                        a(href="/login" class="py-2 hover:font-bold") 
                            p Iniciar Sesion
        
            //-Div usado para mostrar mensajes temporales
            div(class="msj fixed bottom-0 right-10 mb-10 z-20 text-white text-2xl")

            //- Mensajes de alerta (publicaciones dadas de baja, publicaciones denunciadas, denuncias desestimadas de una o más publicaciones)
            if eventos
                - 
                    const estilos = {
                        postsBajas: "border-3 border-red-500 bg-red-200 rounded-[20px] p-6 w-120 h-fit justify-center items-center", 
                        postsDenunciados: "border-3 border-red-500 bg-red-200 rounded-[20px] p-6 w-120 justify-center items-center",
                        denunciasDesestimadas: "border-3 border-green-500 bg-green-200 rounded-[20px] p-6 w-120 h-fit justify-center items-center"
                    }
                .mensajes(class="fixed bg-black/50 flex items-center justify-center z-30 inset-0")
                    div(class="grid grid-cols-1")
                        div(class=`grid grid-cols-${eventos.length} gap-4 flex justify-center`)                         
                            each e in eventos
                                if e === "postsDadasDeBaja"
                                    .content(class= estilos.postsBajas)                               
                                        .msj_postsDadasDeBaja
                                            if postsDadasDeBaja.length === 1
                                                h1(class="text-center") La siguiente publicación fue dada de baja 
                                            else
                                                h1(class="text-center") Las siguientes publicaciones fueron dadas de baja

                                            div(class="flex justify-center items-center")
                                                .infoBajas(class="bg-red-400/50 border px-4 my-4 scrollbar-thin scrollbar-thumb-orange-600 scrollbar-track-orange-100 overflow-y-auto pr-2 max-h-72 w-fit h-fit space-y-3")
                                                    ul(class="list-none my-4")
                                                        each baja in postsDadasDeBaja
                                                            div(class="my-3")
                                                                li 
                                                                    span(class="font-bold") #{baja.titulo}
                                            h1 #{postsDadasDeBaja.length === 1 ? "La misma dejara de ser visible en tu perfil y en la pagina" : "Las mismas dejaran de ser visibles en su perfil y en la pagina"} 
                                            h1 Tu cuenta será inhabilitada si acumula un total de 3 publicaciones dadas de baja 
                                else if e === "postsDenunciados" && (!(postsDenunciados.length === 0) && !postsDenunciadosLeidos)
                                    .content(class= estilos.postsDenunciados)
                                        .msj_postsDenunciados
                                            h1(class="text-center") Tienes #{postsDenunciados.length} publicaciones con denuncias recibidas.

                                            .infoDenuncias(class="bg-red-400/50 border px-4 py-2 my-2 scrollbar-thin scrollbar-thumb-orange-600 scrollbar-track-orange-100 overflow-y-auto pr-2 max-h-60 h-fit space-y-3")
                                                each pd in postsDenunciados
                                                    if pd.denuncia.length === 1
                                                        h1(class="font-bold text-center") #{pd.titulo} (#{pd.denuncia.length} denuncia)
                                                    else
                                                        h1(class="font-bold text-center") #{pd.titulo} (#{pd.denuncia.length} denuncias)

                                                    ul(class="list-none my-2")
                                                        each denuncia in pd.denuncia
                                                            div(class="my-3")
                                                                li 
                                                                    span(class="font-bold") Motivo: 
                                                                    | #{denuncia.motivo}
                                                                li 
                                                                    span(class="font-bold") Descripción: 
                                                                    | #{denuncia.descripción}
                                            h1 Tu publicación se verá afectada si cumple uno o todos los siguientes requisitos:

                                            ul(class="list-none my-2")
                                                li 
                                                    span(class="font-bold") Una o dos denuncias 
                                                    | → se bloquea la edición hasta que sean desestimadas
                                                li 
                                                    span(class="font-bold") Tres denuncias 
                                                    | → su publicación será revisada por el validador de contenidos quien tomara la decisión de 
                                                    span(class="font-bold") dar de baja la publicación 
                                                    | o 
                                                    span(class="font-bold") desestimar las denuncias

                                            h1 Si usted acumula un total de 3 (tres) publicaciones eliminadas o dadas de baja, 
                                                span(class="font-bold text-red-800") tu cuenta quedará inhabilitada permanentemente. 
                                                | Tenga precaución acerca del contenido que publique
                                else if e === "denunciasDesestimadas"
                                    .content(class= estilos.denunciasDesestimadas)
                                        .msj_denunciasDesestimadas
                                            if denunciasDesestimadas.length === 1
                                                h1(class="text-center") Se desestimaron las denuncias de la siguiente publicacion
                                            else
                                                h1(class="text-center") Se desestimaron las denuncias de las siguientes publicaciones
                                            
                                            div(class="flex justify-center items-center")
                                                .infoDesestimadas(class="bg-green-400/50 border px-4 my-4 scrollbar-thin scrollbar-thumb-orange-600 scrollbar-track-orange-100 overflow-y-auto pr-2 max-h-25 w-fit h-fit space-y-3")
                                                    ul(class="list-none my-4")
                                                        each d in denunciasDesestimadas
                                                            div(class="my-3")
                                                                li 
                                                                    span(class="font-bold") #{d.titulo}
                                            h1 La/s publicaciones detalladas seguiran visibles en la pagina y en su perfil
                        .btn_continuar(class="flex justify-center mt-5")
                            form(action="", method="post") 
                                label(for="continuar")
                                    button(type="submit" class="bg-orange-500 hover:bg-orange-600 text-white py-2 px-4 rounded-md cursor-pointer") Continuar