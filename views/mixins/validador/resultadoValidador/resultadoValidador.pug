//- mixins/validador/resultadoValidador/resultadoValidador.pug
mixin resultadoValidador(resultado, titulo, detalle)
    - const ok = resultado === "ok"
    .div_resultado(class="flex items-center justify-center h-150")
        .resultado(class=`bg-white border rounded-[10px] p-8 text-center ${ok ? "border-green-400" : "border-red-400"}`)
            h1(class=`text-3xl font-bold mb-3 ${ok ? "text-green-700" : "text-red-700"}`) #{titulo}
            if detalle
                p(class="text-lg mb-6") #{detalle}
            a(href="/validador" class="inline-block bg-orange-400 hover:bg-orange-500 text-white py-2 px-4 rounded-md") Volver a la lista de trabajo